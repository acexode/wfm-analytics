{
  "openapi": "3.1.0",
  "info": {
    "title": "WFM Analytics first slice",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/teams/{teamId}/daily": {
      "get": {
        "operationId": "getTeamDaily",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped daily report; synthetic data explicitly identified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./daily-report.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date or request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Team scope denied"
          },
          "404": {
            "description": "Unknown team"
          }
        }
      }
    },
    "/api/v1/activity/batches": {
      "post": {
        "operationId": "ingestActivityBatch",
        "description": "Planned contract; not implemented by development demo. Identity derives from enrollment credential, never request body. Max 512 KiB uncompressed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./activity-batch.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-event outcomes only after durable commit: accepted, already_accepted, rejected",
            "content": {
              "application/json": {
                "schema": {"$ref": "./activity-batch-response.schema.json"}
              }
            }
          },
          "400": {
            "description": "Invalid payload"
          },
          "401": {
            "description": "Missing or invalid enrollment credential"
          },
          "413": {
            "description": "Payload exceeds 512 KiB"
          },
          "429": {
            "description": "Admission limit; retry with backoff"
          }
        }
      }
    }
  }
}
