{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "outcomes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "format": "uuid"},
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "status", "rejection_reason"],
        "properties": {
          "event_id": {"type": "string", "format": "uuid"},
          "status": {"enum": ["accepted", "already_accepted", "rejected"]},
          "rejection_reason": {"type": ["string", "null"]}
        },
        "allOf": [{
          "if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]},
          "then": {"properties": {"rejection_reason": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"rejection_reason": {"type": "null"}}}
        }]
      }
    }
  }
}
