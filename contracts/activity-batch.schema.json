{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "agent_version",
    "policy_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "boot_id",
          "session_id",
          "collector_instance_id",
          "sequence",
          "bucket_start",
          "bucket_end",
          "coarsened",
          "slices"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "boot_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "collector_instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "bucket_start": {
            "type": "string",
            "format": "date-time"
          },
          "bucket_end": {
            "type": "string",
            "format": "date-time"
          },
          "coarsened": {
            "type": "boolean"
          },
          "slices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_offset_ms",
                "end_offset_ms",
                "application_id",
                "state"
              ],
              "properties": {
                "start_offset_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 59999
                },
                "end_offset_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000
                },
                "application_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
                },
                "state": {
                  "enum": [
                    "active",
                    "inactive",
                    "locked",
                    "detail_unavailable"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
